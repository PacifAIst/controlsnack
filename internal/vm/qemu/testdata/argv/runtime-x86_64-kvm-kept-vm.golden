/usr/bin/qemu-system-x86_64
-name
controlsnack-abc
-nodefaults
-no-user-config
-machine
q35
-enable-kvm
-cpu
host
-smp
2
-m
2048
-drive
if=virtio,format=qcow2,file=/run/user/1000/cs-abc/disk.qcow2,cache=writeback,discard=unmap
-device
virtio-vga,xres=1280,yres=800
-device
qemu-xhci
-device
usb-tablet
-device
usb-kbd
-device
virtio-rng-pci
-device
virtio-serial-pci
-chardev
socket,id=agent0,path=/tmp/cs-s1/agent.sock,server=on,wait=on
-device
virtserialport,chardev=agent0,id=agent0,name=org.controlsnack.agent.0
-chardev
socket,id=qmp0,path=/tmp/cs-s1/qmp.sock,server=on,wait=on
-mon
chardev=qmp0,mode=control
-serial
file:/run/user/1000/cs-abc/serial.log
-display
none
-nic
none
-no-reboot
-sandbox
on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny
