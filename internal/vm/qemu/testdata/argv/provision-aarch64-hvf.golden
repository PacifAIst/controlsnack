/usr/bin/qemu-system-aarch64
-name
controlsnack-provision
-nodefaults
-no-user-config
-machine
virt
-accel
hvf
-cpu
host
-smp
2
-m
2048
-drive
if=pflash,format=raw,readonly=on,file=/usr/share/AAVMF/AAVMF_CODE.fd
-drive
if=pflash,format=raw,file=/run/user/1000/cs-abc/vars.fd
-drive
if=virtio,format=qcow2,file=/run/user/1000/cs-abc/work.qcow2,cache=unsafe,discard=unmap
-drive
if=virtio,format=raw,media=cdrom,readonly=on,file=/run/user/1000/cs-abc/seed.iso
-device
virtio-gpu-pci,xres=1280,yres=800
-device
virtio-rng-pci
-chardev
socket,id=qmp0,path=/tmp/cs-s1/qmp.sock,server=on,wait=on
-mon
chardev=qmp0,mode=control
-serial
file:/run/user/1000/cs-abc/serial.log
-display
none
-nic
user,model=virtio-net-pci
-no-reboot
