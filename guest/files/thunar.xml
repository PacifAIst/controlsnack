<?xml version="1.0" encoding="UTF-8"?>
<!--
  ControlSnack: the file manager lists a folder as a detailed list. Its icon view is one element for the whole folder in
  the accessibility tree (the agent sees no file names), while the list exposes every file's name, size, type and date.
-->
<channel name="thunar" version="1.0">
  <property name="last-view" type="string" value="ThunarDetailsView"/>
</channel>
